# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Supabase > Project Settings > API Keys (ou "Connect" no topo do painel).

# URL do projeto, ex.: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (publishable, começa com sb_publishable_...).
# Projetos antigos: pode usar a "anon key" no lugar.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço do site, usado no link mágico. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
