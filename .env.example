# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Supabase > Project Settings > API Keys (ou "Connect" no topo do painel).

# URL do projeto, ex.: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (publishable, começa com sb_publishable_...).
# Projetos antigos: pode usar a "anon key" no lugar.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço do site, usado no link mágico. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Proteção da inscrição (README, passo "Proteção da inscrição")
# ---------------------------------------------------------------------

# Segredo que assina cada inscrição (mínimo 32 caracteres). O MESMO valor vai no banco
# (tabela private.app_secrets). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca use o prefixo NEXT_PUBLIC_ aqui: ele não pode ir para o navegador.
REGISTRATION_SIGNING_SECRET=

# Cloudflare Turnstile (anti-robô). Vazio = sem anti-robô (só no seu computador).
# Chaves de teste da Cloudflare que sempre passam (use no computador):
#   site key 1x00000000000000000000AA · secret key 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------
# E-mail automático (opcional): link da página do inscrito por e-mail
# ---------------------------------------------------------------------

# Resend (https://resend.com). Vazio = não envia e-mail (o resto funciona normal).
# EMAIL_FROM precisa ser de um domínio verificado no Resend, ex.: Routa <inscricoes@routa.com.br>
RESEND_API_KEY=
EMAIL_FROM=
