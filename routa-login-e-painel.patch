+
+/* Tela de login: a foto entra devagar, como quem chega na curva. */
+@media (prefers-reduced-motion: no-preference) {
+  .login-hero-img {
+    animation: login-hero-in 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
+  }
+}
+@keyframes login-hero-in {
+  from {
+    transform: scale(1.06);
+    opacity: 0.6;
+  }
+  to {
+    transform: scale(1);
+    opacity: 1;
+  }
+}
+
+/* Painel do organizador: comboio, mostradores e contagem regressiva. */
+.convoy-seat {
+  @apply flex h-8 w-8 items-center justify-center rounded-md;
+}
+.convoy-seat[data-state="paid"] {
+  @apply bg-orange-500 text-white;
+}
+.convoy-seat[data-state="confirmed"] {
+  @apply bg-orange-500/15 text-orange-300 ring-1 ring-orange-400/70;
+}
+.convoy-seat[data-state="free"] {
+  @apply bg-white/5 text-white/30 ring-1 ring-white/15;
+}
+@media (prefers-reduced-motion: no-preference) {
+  .convoy-seat {
+    animation: convoy-in 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
+  }
+  .gauge-needle {
+    transform-box: view-box;
+    transform-origin: 100px 100px;
+    animation: gauge-sweep 1.3s cubic-bezier(0.3, 1.3, 0.5, 1) both;
+  }
+  .gauge-arc {
+    animation: gauge-fill 1.1s ease-out both;
+  }
+  .cockpit-count {
+    animation: convoy-in 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
+  }
+}
+@keyframes convoy-in {
+  from {
+    opacity: 0;
+    transform: translateX(-10px);
+  }
+}
+@keyframes gauge-sweep {
+  from {
+    transform: rotate(-90deg);
+  }
+  to {
+    transform: rotate(var(--to));
+  }
+}
+@keyframes gauge-fill {
+  from {
+    stroke-dasharray: 0 100;
+  }
+}
